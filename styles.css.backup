:root{--bg:#080a12;--panel:#101320;--panel2:#14182a;--border:#24283b;--text:#f4f5fb;--muted:#8b91aa;--blue:#6b7cff;--purple:#a36bff;--cyan:#5ee7ff;--radius:18px}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px}button,input,select,textarea{font:inherit}button{cursor:pointer}.app-shell{min-height:100vh;display:flex}.sidebar{width:244px;position:fixed;inset:0 auto 0 0;background:#0b0d16;border-right:1px solid #1c2030;padding:27px 15px 14px;display:flex;flex-direction:column;z-index:5}.brand{display:flex;gap:11px;align-items:center;text-decoration:none;color:var(--text);font:700 19px 'Space Grotesk',sans-serif;padding:0 10px 38px;letter-spacing:-.7px}.brand-mark{display:grid;place-items:center;width:36px;height:36px;border-radius:12px;background:linear-gradient(140deg,var(--blue),var(--purple));box-shadow:0 5px 24px #7669ff44;color:white;font-size:23px}.brand-ai{color:#a8a4ff}.brand small{display:block;font:600 9px 'DM Sans';letter-spacing:2px;color:#777e9b;margin-top:3px}.side-label{font-size:10px;font-weight:700;letter-spacing:1.8px;color:#626982;padding:0 12px 12px}.sidebar nav{display:grid;gap:5px}.nav-item{border:0;background:transparent;color:#969cb4;padding:12px;border-radius:11px;display:flex;align-items:center;gap:12px;text-align:left;width:100%;font-weight:600;transition:.18s}.nav-item>span:first-child{font-size:19px;width:20px;text-align:center}.nav-item:hover{background:#171a2b;color:white}.nav-item.active{background:linear-gradient(90deg,#24254b,#1b1b35);color:#c5c7ff;box-shadow:inset 2px 0 var(--blue)}.soon{font-size:9px;background:#25203c;color:#c1a5ff;padding:4px 6px;border-radius:5px;margin-left:auto}.count{margin-left:auto;background:#202439;border-radius:7px;padding:3px 7px;font-size:11px}.sidebar-bottom{margin-top:auto}.plan-card{background:linear-gradient(145deg,#171a31,#171225);border:1px solid #2a2b49;border-radius:15px;padding:16px;margin:0 2px 16px}.plan-icon{font-size:22px;color:#b9a2ff;margin-bottom:10px}.plan-card strong{font:600 13px 'Space Grotesk';line-height:1.4}.plan-card p{font-size:11px;line-height:1.5;color:var(--muted)}.small-cta{width:100%;background:#2d2c55;color:#d9d6ff;border:1px solid #474476;border-radius:8px;padding:9px 10px;text-align:left;font-weight:600;font-size:11px}.small-cta span{float:right}.user-chip{display:flex;align-items:center;gap:10px;padding:17px 7px 3px;border-top:1px solid #202334;margin-top:12px}.avatar{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:#2d2850;color:#c7b9ff;font-weight:700}.user-chip strong,.user-chip small{display:block}.user-chip strong{font-size:12px}.user-chip small{color:var(--muted);font-size:10px;margin-top:3px}.online-dot{width:7px;height:7px;border-radius:50%;background:#58d8a0;margin-left:auto}.main{margin-left:244px;width:calc(100% - 244px);min-height:100vh;display:flex;flex-direction:column}.topbar{height:70px;border-bottom:1px solid #1c2030;display:flex;align-items:center;justify-content:space-between;padding:0 38px;position:sticky;top:0;background:#080a12eF;backdrop-filter:blur(16px);z-index:4}.breadcrumb{font-size:12px;color:#737b96}.breadcrumb span{padding:0 9px;color:#444b65}.breadcrumb b{color:#e4e6f3;font-weight:500}.top-actions{display:flex;align-items:center;gap:12px}.demo-pill{color:#b2b8ce;font-size:11px;border:1px solid #2a3043;border-radius:30px;padding:7px 10px}.demo-pill i{display:inline-block;width:6px;height:6px;background:#e9b55f;border-radius:50%;margin-right:6px}.icon-btn{width:28px;height:28px;border-radius:50%;border:1px solid #343951;background:transparent;color:#9ca4c1}.mobile-brand{display:none}.content{width:min(1120px,100%);margin:0 auto;padding:36px 38px 48px;flex:1}.eyebrow{color:#a69aff;font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase}.hero{position:relative;overflow:hidden;border:1px solid #2a2a4b;border-radius:23px;background:radial-gradient(ellipse at 83% 13%,#4b3a8a55,transparent 38%),radial-gradient(ellipse at 70% 100%,#183f7655,transparent 38%),linear-gradient(115deg,#171a30,#111321 66%);padding:36px 35px 30px;min-height:240px}.hero:after{content:'✦';position:absolute;right:8%;top:20px;font-size:170px;line-height:1;color:#9c91ff0b;pointer-events:none}.hero h1{font:700 clamp(29px,4vw,43px)/1.12 'Space Grotesk';letter-spacing:-1.8px;max-width:570px;margin:14px 0 12px}.gradient-text{background:linear-gradient(90deg,#a9a5ff,#d1a8ff 50%,#72e5ff);background-clip:text;color:transparent}.hero p{color:#a6acc4;line-height:1.65;max-width:460px;margin:0 0 23px}.primary-btn,.secondary-btn,.ghost-btn{border:0;border-radius:10px;padding:12px 16px;font-weight:700;font-size:12px;transition:transform .15s,filter .15s}.primary-btn{background:linear-gradient(110deg,#6d76ff,#985dff);color:white;box-shadow:0 6px 24px #7468ff35}.primary-btn:hover,.secondary-btn:hover{filter:brightness(1.12);transform:translateY(-1px)}.primary-btn:disabled{opacity:.6;cursor:wait;transform:none}.secondary-btn{background:#20243b;color:#d9dcf0;border:1px solid #343a58}.ghost-btn{background:transparent;border:1px solid #343951;color:#b7bdd2}.section-head{display:flex;align-items:end;justify-content:space-between;margin:30px 0 15px}.section-head h2{font:600 18px 'Space Grotesk';letter-spacing:-.4px;margin:0 0 5px}.section-head p{margin:0;color:var(--muted);font-size:12px}.text-link{background:none;border:0;color:#a9a4ff;font-size:12px;font-weight:700}.quick-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.tool-card{background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:17px;min-height:147px;cursor:pointer;transition:.2s;position:relative;overflow:hidden}.tool-card:hover{transform:translateY(-3px);border-color:#55508b;background:#14172a}.tool-icon{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;font-size:20px;margin-bottom:15px}.icon-blue{background:#22284c;color:#8f9dff}.icon-purple{background:#302244;color:#c09aff}.icon-cyan{background:#17323c;color:#76e6fa}.icon-pink{background:#3b213b;color:#ff9cdb}.tool-card h3{font:600 13px 'Space Grotesk';margin:0 0 6px}.tool-card p{font-size:11px;color:#9299b1;line-height:1.5;margin:0}.tool-arrow{position:absolute;right:16px;top:17px;color:#666e8d}.bottom-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:15px;margin-top:25px}.panel{background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:20px}.panel h3{font:600 15px 'Space Grotesk';margin:0 0 5px}.panel-sub{font-size:11px;color:var(--muted);margin:0 0 18px}.empty-state{border:1px dashed #30354b;border-radius:12px;padding:23px 15px;text-align:center;color:var(--muted);font-size:12px;line-height:1.6}.empty-state .empty-icon{font-size:25px;color:#7971bd;margin-bottom:7px}.recent-list{display:grid;gap:8px}.recent-item{display:flex;align-items:center;gap:10px;border:1px solid #24283b;background:#121624;padding:11px;border-radius:10px;min-width:0}.recent-item .ri-icon{color:#a99aff;font-size:17px}.recent-item .ri-copy{min-width:0;flex:1}.recent-item strong{display:block;font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.recent-item small{display:block;color:var(--muted);font-size:10px;margin-top:4px}.recent-item button{background:none;border:0;color:#a6a0ff;font-size:11px}.page-title{font:700 30px 'Space Grotesk';letter-spacing:-1px;margin:9px 0}.page-desc{color:var(--muted);font-size:13px;line-height:1.6;margin:0 0 25px}.create-layout{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:18px;align-items:start}.form-panel,.results-panel{background:var(--panel);border:1px solid var(--border);border-radius:17px;padding:22px;min-width:0}.panel-title{font:600 16px 'Space Grotesk';margin:0 0 5px}.field{margin-top:19px}.field label{display:block;color:#cbd0e2;font-weight:600;font-size:12px;margin-bottom:8px}.field small{display:block;color:#777f9b;font-size:10px;margin-top:7px;line-height:1.5}.field input,.field select,.field textarea,.settings-input{width:100%;background:#0b0e18;border:1px solid #30354a;color:#edf0fc;border-radius:9px;padding:12px;outline:none;min-height:42px}.field textarea{min-height:92px;resize:vertical;line-height:1.5}.field input:focus,.field select:focus,.field textarea:focus,.settings-input:focus{border-color:#7970ff;box-shadow:0 0 0 3px #7970ff1b}.field select option{background:#101320}.segmented{display:flex;gap:6px;flex-wrap:wrap}.segment{border:1px solid #30354a;background:#0d101b;color:#9ca3bc;border-radius:8px;padding:9px 11px;font-size:11px}.segment.selected{background:#27264a;border-color:#6962b4;color:#d7d3ff}.full-btn{width:100%;margin-top:22px}.results-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:16px}.results-head h3{font:600 15px 'Space Grotesk';margin:0}.result-list{display:grid;gap:9px}.result-card{display:flex;align-items:flex-start;gap:10px;padding:13px;border:1px solid #282d42;border-radius:11px;background:#121624;animation:rise .3s both}.result-num{display:grid;place-items:center;flex:0 0 25px;height:25px;border-radius:8px;background:#292747;color:#b9b1ff;font-size:10px;font-weight:700}.result-text{font-size:12px;line-height:1.55;color:#e3e6f4;flex:1;white-space:pre-wrap;overflow-wrap:anywhere}.copy-one{background:none;border:0;color:#8f96b1;font-size:15px;padding:3px}.copy-one:hover{color:white}.result-placeholder{padding:45px 15px;text-align:center;color:#828aa5}.result-placeholder .big-spark{font-size:30px;color:#847aff;margin-bottom:10px}.result-placeholder strong{display:block;color:#c7cbe0;font-size:13px;margin-bottom:7px}.result-placeholder p{font-size:11px;line-height:1.6;max-width:230px;margin:auto}.status-line{color:#929ab5;font-size:11px;margin:12px 0 0}.status-line.error{color:#ff9baf}.saved-toolbar{display:flex;gap:10px;margin-bottom:18px}.saved-toolbar input{flex:1;min-width:0;background:#101320;border:1px solid var(--border);border-radius:9px;padding:11px 12px;color:white}.saved-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.saved-card{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:16px;min-width:0}.saved-card-head{display:flex;justify-content:space-between;gap:10px;align-items:center}.type-tag{font-size:9px;text-transform:uppercase;letter-spacing:.7px;color:#b7adff;background:#272441;border-radius:5px;padding:5px 7px}.saved-card h3{font:600 13px 'Space Grotesk';margin:12px 0 8px;overflow-wrap:anywhere}.saved-card p{font-size:11px;color:#9ba2ba;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere;max-height:100px;overflow:auto}.saved-card-actions{display:flex;gap:7px;border-top:1px solid #272b3e;padding-top:12px;margin-top:12px}.saved-card-actions button{background:#1b2031;color:#bdc3d9;border:1px solid #30354a;border-radius:7px;padding:7px 9px;font-size:10px}.saved-card-actions .delete{margin-left:auto;color:#ff9eaf}.setting-row{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:17px 0;border-bottom:1px solid #252a3d}.setting-row:last-child{border:0}.setting-row strong{font-size:12px}.setting-row p{font-size:11px;color:var(--muted);margin:5px 0 0;line-height:1.5}.toggle{width:42px;height:23px;border-radius:20px;background:#383d52;border:0;padding:3px;flex-shrink:0}.toggle:after{content:'';display:block;width:17px;height:17px;background:white;border-radius:50%;transition:.2s}.toggle.on{background:#6f70ee}.toggle.on:after{transform:translateX(19px)}.meme-layout{display:grid;grid-template-columns:1fr 1fr;gap:18px}.meme-preview{background:#0b0d16;border:1px dashed #373b51;border-radius:15px;min-height:330px;display:grid;place-items:center;padding:20px;overflow:hidden}.meme-canvas{position:relative;width:100%;max-width:360px;aspect-ratio:1/1;background:linear-gradient(145deg,#292347,#153b51);border-radius:8px;display:flex;align-items:center;justify-content:center;overflow:hidden;background-size:cover;background-position:center}.meme-canvas img{position:absolute;width:100%;height:100%;object-fit:cover}.meme-overlay{position:relative;z-index:1;color:white;font-weight:900;font-family:Impact,'Arial Black',sans-serif;text-transform:uppercase;text-align:center;font-size:clamp(19px,3vw,29px);line-height:1.15;letter-spacing:.5px;padding:12px;text-shadow:2px 2px 0 #000,-2px -2px 0 #000,2px -2px 0 #000,-2px 2px 0 #000;overflow-wrap:anywhere}.file-input{font-size:11px!important;padding:9px!important}.settings-box{max-width:720px}.notice{padding:12px;border:1px solid #353455;background:#17162a;border-radius:10px;color:#bcb9e6;font-size:11px;line-height:1.6;margin-top:16px}.loading-dot{display:inline-block;width:7px;height:7px;background:currentColor;border-radius:50%;margin-right:5px;animation:pulse 1s infinite alternate}@keyframes pulse{to{opacity:.25}}@keyframes rise{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}footer{border-top:1px solid #1c2030;padding:17px 38px;color:#7e859e;font-size:11px}footer span{color:#9e91ff}footer small{float:right;color:#5f6680}#toast{position:fixed;bottom:25px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:#e8e9ff;color:#17162c;padding:11px 16px;border-radius:10px;font-weight:700;font-size:12px;box-shadow:0 8px 30px #0008;transition:.2s;z-index:20;max-width:90vw;text-align:center}#toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:1050px){.sidebar{width:215px}.main{margin-left:215px;width:calc(100% - 215px)}.content{padding:28px 24px}.topbar{padding:0 24px}.quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.tool-card{min-height:130px}.bottom-grid{grid-template-columns:1fr 1fr}}
@media(max-width:720px){.sidebar{width:100%;height:64px;inset:auto 0 0;background:#0d0f1a;border-right:0;border-top:1px solid #2b3044;padding:5px 7px;display:block}.sidebar .brand,.side-label,.sidebar-bottom{display:none}.sidebar nav{display:flex;justify-content:space-around;gap:3px;height:100%}.nav-item{display:flex;flex-direction:column;justify-content:center;gap:2px;text-align:center;padding:5px 2px;font-size:9px;border-radius:8px;min-width:0}.nav-item>span:first-child{font-size:18px;width:auto}.nav-item .soon,.nav-item .count{display:none}.main{margin-left:0;width:100%;padding-bottom:64px}.topbar{height:58px;padding:0 17px}.breadcrumb{display:none}.mobile-brand{display:flex;align-items:center;gap:8px;font:700 16px 'Space Grotesk'}.mobile-brand .brand-mark{width:28px;height:28px;font-size:17px;border-radius:9px}.demo-pill{font-size:9px;padding:6px 8px}.content{padding:20px 15px 28px}.hero{padding:27px 22px 24px;min-height:0}.hero h1{font-size:31px;letter-spacing:-1.2px}.hero p{font-size:12px}.quick-grid{gap:9px}.tool-card{padding:13px;min-height:139px}.tool-icon{margin-bottom:12px}.tool-card h3{font-size:12px}.tool-card p{font-size:10px}.bottom-grid{grid-template-columns:1fr;gap:12px;margin-top:18px}.section-head{margin-top:25px}.section-head h2{font-size:16px}.page-title{font-size:27px}.create-layout,.meme-layout{grid-template-columns:1fr;gap:13px}.form-panel,.results-panel{padding:17px}.saved-grid{grid-template-columns:1fr}.saved-toolbar{flex-wrap:wrap}.saved-toolbar input{width:100%;flex-basis:100%}.meme-preview{min-height:250px}.meme-canvas{max-width:300px}footer{padding:14px 17px;font-size:10px}footer small{float:none;display:block;margin-top:5px}.section-head .text-link{font-size:11px}}
@media(max-width:360px){.hero h1{font-size:27px}.quick-grid{grid-template-columns:1fr 1fr}.tool-card{min-height:145px}.demo-pill{display:none}.hero{padding:23px 17px}}
